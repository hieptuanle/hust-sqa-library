<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Library Manager</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        max-width: 800px;
        margin: auto;
        padding: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th,
      td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      th {
        background-color: #f2f2f2;
      }
      form {
        margin-bottom: 20px;
      }
      input,
      select,
      button {
        margin-right: 10px;
      }
      .error {
        color: red;
      }
    </style>
  </head>
  <body>
    <h1>Library Book Manager</h1>
    <% if (user) { %>
    <p>Welcome, <%= user %>! <a href="/logout">Logout</a></p>
    <h2>Add New Book</h2>
    <form action="/add" method="post">
      <input type="text" name="title" placeholder="Title" required />
      <input type="text" name="author" placeholder="Author" required />
      <input
        type="number"
        name="year"
        placeholder="Publication Year"
        required
        min="1400"
        max="<%= new Date().getFullYear() %>"
      />
      <button type="submit">Add Book</button>
    </form>
    <% } else { %>
    <p>
      <a href="/login">Login</a> or <a href="/register">Register</a> to add or
      delete books.
    </p>
    <% } %>

    <h2>Search Books</h2>
    <form action="/" method="get">
      <input
        type="text"
        name="query"
        placeholder="Search..."
        value="<%= query || '' %>"
      />
      <label
        ><input type="radio" name="type" value="title" <%= (type === 'title' ||
        !type) ? 'checked' : '' %>> Title</label
      >
      <label
        ><input type="radio" name="type" value="author" <%= type === 'author' ?
        'checked' : '' %>> Author</label
      >
      <button type="submit">Search</button>
    </form>

    <h2>Books</h2>
    <% if (error) { %>
    <p class="error"><%= error %></p>
    <% } %>
    <table>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Author</th>
        <th>Year</th>
        <% if (user) { %>
        <th>Action</th>
        <% } %>
      </tr>
      <% books.forEach(book => { %>
      <tr>
        <td><%= book.id %></td>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.year %></td>
        <% if (user) { %>
        <td>
          <form
            action="/delete/<%= book.id %>"
            method="post"
            style="display: inline"
          >
            <button type="submit">Delete</button>
          </form>
        </td>
        <% } %>
      </tr>
      <% }); %>
    </table>
  </body>
</html>
